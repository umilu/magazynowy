{
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "printWidth": 100,
    "plugins": ["prettier-plugin-sql"],
    "overrides": [
        {
            "files": "*.sql",
            "options": {
                "language": "postgresql",
                "keywordCase": "upper",
                "dataTypeCase": "upper",
                "functionCase": "lower"
            }
        }
    ]
}
